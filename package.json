{
  "name": "calida",
  "private": true,
  "description": "Plataforma de voluntariado en Cali. Ver README.md y docs/00-guia-de-proyecto.md.",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "compartido",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "dev:monorepo": "concurrently --names api,web --prefix-colors blue,green \"npm run dev -w @calida/backend\" \"npm run dev -w @calida/frontend\""
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "version": "0.1.0",
  "dependencies": {
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
